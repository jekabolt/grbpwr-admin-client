{
  "prettierDifferingFiles": 182,
  "rules": {
    "@typescript-eslint/ban-ts-comment": 10,
    "@typescript-eslint/no-empty-object-type": 160,
    "@typescript-eslint/no-explicit-any": 335,
    "@typescript-eslint/no-non-null-asserted-optional-chain": 1,
