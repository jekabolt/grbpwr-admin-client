{
  "id": "trousers",
  "category": "trousers",
  "garmentName": "Trousers",
  "_note": "Trousers, panel method (2 of 2 technologists' cards): pockets, fly and waistband built first \u2192 pockets set on their panels \u2192 the backs into one back (seat seam, yoke) \u2192 the fronts into one front (fly) \u2192 back and front in one (side seams, inseams, crotch) \u2192 zipper \u2192 waistband \u2192 belt loops \u2192 hem \u2192 buttons \u2192 final press. Sewing leg by leg (side seam, inseam, then the crotch) is the other industrial method; it is not offered as a reading.",
  "pressOpen": true,
  "pressFlat": false,
  "mergeHands": ["waistband", "yoke"],
  "fuseRoles": ["waistband", "fly", "pocket", "facing"],
  "stages": [
    {
      "id": "fuse",
      "op": "fuse",
      "label": "Fuse interlining"
    },
    { "id": "features", "op": "features", "label": "Darts" },
    {
      "id": "subassemblies",
      "op": "units",
      "label": "Pockets, fly, waistband",
      "roles": ["pocket", "fly", "waistband", "facing", "loop"]
    },
    {
      "id": "panels",
      "op": "units",
      "label": "Front and back legs",
      "roles": ["front", "back", "yoke", "side", "*"]
    },
    {
      "id": "back",
      "op": "combine",
      "label": "Join the back panels",
      "roles": ["back", "yoke"],
      "requireAll": ["back"],
      "as": "back",
      "name": "Back",
      "zone": "BACK",
      "press": "open"
    },
    {
      "id": "front",
      "op": "combine",
      "label": "Join the front panels",
      "roles": ["front"],
      "requireAll": ["front"],
      "as": "front",
      "name": "Front",
      "zone": "FRONT",
      "press": "open"
    },
    {
      "id": "body",
      "op": "combine",
      "label": "Join back and front: side seams, inseams, crotch",
      "roles": ["front", "back", "side"],
      "requireAll": ["front", "back"],
      "as": "body",
      "name": "Body",
      "zone": "OUTER",
      "press": "open"
    },
    {
      "id": "zipper",
      "op": "bom",
      "label": "Set the zipper",
      "when": "zipper",
      "machine": "zipper_setting",
      "zone": "CLOSURE"
    },
    {
      "id": "waistband",
      "op": "attach",
      "label": "Attach the waistband",
      "roles": ["waistband"],
      "to": ["body"],
      "together": true,
      "name": "Body with waistband",
      "zone": "WAIST",
      "press": "flat"
    },
    {
      "id": "elastic",
      "op": "bom",
      "label": "Attach elastic",
      "when": "elastic",
      "machine": "elastic_attach",
      "zone": "WAIST"
    },
    {
      "id": "loops",
      "op": "attach",
      "label": "Attach belt loops",
      "roles": ["loop"],
      "to": ["body"],
      "together": true,
      "name": "Body with belt loops",
      "zone": "WAIST"
    },
    {
      "id": "hem",
      "op": "process",
      "label": "Hem",
      "roles": ["body"],
      "zone": "HEM"
    },
    {
      "id": "buttonholes",
      "op": "bom",
      "label": "Buttonholes",
      "when": "buttons",
      "machine": "buttonhole",
      "zone": "CLOSURE"
    },
    {
      "id": "buttons",
      "op": "bom",
      "label": "Attach buttons",
      "when": "buttons",
      "machine": "button_attach",
      "zone": "CLOSURE"
    },
    {
      "id": "snaps",
      "op": "bom",
      "label": "Set snaps",
      "when": "snaps",
      "machine": "other",
      "zone": "CLOSURE"
    },
    {
      "id": "drawcord",
      "op": "bom",
      "label": "Thread the drawcord",
      "when": "drawcord",
      "operationType": "HANDWORK",
      "zone": "WAIST"
    },
    {
      "id": "final-press",
      "op": "press",
      "label": "Final press",
      "zone": "OUTER"
    }
  ]
}
