{
  "id": "jumpsuit",
  "category": "jumpsuit",
  "garmentName": "Jumpsuit",
  "_note": "Jumpsuit / overall: subassemblies → panels → side seams per leg (front + back of one hand) → inseam → crotch: the two halves into one body → collar → sleeves → cuffs → zipper → waistband or belt → elastic → belt loops → lining bagged in (if lined) → hem → closures → final press. Back halves stay apart until the crotch seam, as in trousers.",
  "pressOpen": true,
  "pressFlat": false,
  "mergeHands": ["yoke", "collar", "stand", "hood", "waistband"],
  "fuseRoles": ["collar", "stand", "cuff", "placket", "facing", "pocket", "waistband", "fly"],
  "stages": [
    {
      "id": "fuse",
      "op": "fuse",
      "label": "Fuse interlining"
    },
    {
      "id": "subassemblies",
      "op": "units",
      "label": "Collar, pockets, fly, cuffs",
      "roles": [
        "collar",
        "stand",
        "hood",
        "rib",
        "cuff",
        "pocket",
        "placket",
        "fly",
        "facing",
        "waistband",
        "loop"
      ]
    },
    {
      "id": "panels",
      "op": "units",
      "label": "Front and back panels",
      "roles": ["front", "back", "yoke", "side", "sleeve", "*"]
    },
    {
      "id": "sides",
      "op": "combine",
      "label": "Join side seams",
      "roles": ["front", "back", "yoke", "side"],
      "requireAll": ["front", "back"],
      "byHand": true,
      "as": "leg",
      "name": "half",
      "zone": "OUTER",
      "press": "open"
    },
    {
      "id": "inseam",
      "op": "process",
      "label": "Close the inseam",
      "roles": ["leg"],
      "zone": "OUTER",
      "press": "open"
    },
    {
      "id": "crotch",
      "op": "combine",
      "label": "Join the halves at the crotch and centre seams",
      "roles": ["leg", "front", "back", "yoke"],
      "as": "body",
      "name": "Body",
      "zone": "HIP",
      "press": "open"
    },
    {
      "id": "collar",
      "op": "attach",
      "label": "Set the collar or neckline",
      "roles": ["collar", "stand", "hood", "rib"],
      "to": ["body"],
      "together": true,
      "name": "Body with collar",
      "zone": "NECKLINE",
      "press": "flat"
    },
    {
      "id": "sleeves",
      "op": "attach",
      "label": "Set sleeves",
      "roles": ["sleeve"],
      "to": ["body"],
      "together": true,
      "name": "Body with sleeves",
      "zone": "SLEEVE",
      "press": "open"
    },
    {
      "id": "cuffs",
      "op": "attach",
      "label": "Attach cuffs",
      "roles": ["cuff"],
      "to": ["body"],
      "together": true,
      "name": "Body with cuffs",
      "zone": "SLEEVE",
      "press": "flat"
    },
    {
      "id": "zipper",
      "op": "bom",
      "label": "Set the zipper",
      "when": "zipper",
      "machine": "zipper_setting",
      "zone": "CLOSURE"
    },
    {
      "id": "waistband",
      "op": "attach",
      "label": "Attach the waistband or belt",
      "roles": ["waistband"],
      "to": ["body"],
      "together": true,
      "name": "Body with waistband",
      "zone": "WAIST",
      "press": "flat"
    },
    {
      "id": "elastic",
      "op": "bom",
      "label": "Attach elastic",
      "when": "elastic",
      "machine": "elastic_attach",
      "zone": "WAIST"
    },
    {
      "id": "loops",
      "op": "attach",
      "label": "Attach belt loops",
      "roles": ["loop"],
      "to": ["body"],
      "together": true,
      "name": "Body with belt loops",
      "zone": "WAIST"
    },
    {
      "id": "bag",
      "op": "bag",
      "label": "Bag the lining into the shell",
      "roles": ["facing"],
      "name": "Jumpsuit",
      "zone": "LINING",
      "press": "flat"
    },
    {
      "id": "hem",
      "op": "process",
      "label": "Hem",
      "roles": ["body"],
      "zone": "HEM"
    },
    {
      "id": "buttonholes",
      "op": "bom",
      "label": "Buttonholes",
      "when": "buttons",
      "machine": "buttonhole",
      "zone": "CLOSURE"
    },
    {
      "id": "buttons",
      "op": "bom",
      "label": "Attach buttons",
      "when": "buttons",
      "machine": "button_attach",
      "zone": "CLOSURE"
    },
    {
      "id": "snaps",
      "op": "bom",
      "label": "Set snaps",
      "when": "snaps",
      "machine": "other",
      "zone": "CLOSURE"
    },
    {
      "id": "drawcord",
      "op": "bom",
      "label": "Thread the drawcord",
      "when": "drawcord",
      "operationType": "HANDWORK",
      "zone": "OUTER"
    },
    {
      "id": "final-press",
      "op": "press",
      "label": "Final press",
      "zone": "OUTER"
    }
  ]
}
