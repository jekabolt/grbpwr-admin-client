REACT_APP_SERVER_URL = "BACKEND_URL_PLACEHOLDER"

# OpenRouter — server-side only, do NOT prefix with VITE_ (keeps it out of the bundle).
# Used by POST /api/translate to AI-translate localization fields into every language.
OPENROUTER_API_KEY = "OPENROUTER_API_KEY_PLACEHOLDER"
OPENROUTER_MODEL = "google/gemini-2.5-flash"

# Storefront base URL for the hero live-preview iframe (/preview/hero).
# Set per environment in Vercel (project grbpwr-admin-client):
#   Production           -> https://grbpwr.com
#   Preview (beta branch)-> https://beta.grbpwr.com
#   Development          -> https://grbpwr.com
# Local `yarn dev` uses this file (or the code fallback http://localhost:3000) — run the
# storefront locally, or set a value here. The admin origin must be allowlisted on the
# storefront's /preview/* frame-ancestors + ADMIN_ORIGINS, else the iframe is blocked.
VITE_STOREFRONT_URL = "http://localhost:3000"
# Seller VAT/NIP printed on commercial invoices (invoice-document.tsx).
# Set in Vercel: Production -> the real GRBPWR VAT/NIP (PL registration).
# While unset, printed invoices show "SELLER VAT ID NOT CONFIGURED" instead of a number.
VITE_SELLER_VAT_ID = ""

# Origin baked into the QR codes of BOTH printed public viewers: the tech pack's pattern
# viewer ({origin}/p/{token}) and the run pack ({origin}/r/{token}), AND the origin of the
# public file-share page ({origin}/f/{token}) that the access block and the shared-files screen
# copy to the clipboard. One variable for all three — they are pages of this same SPA
# (src/utils/viewer-origin.ts, src/components/file-share-viewer/link.ts).
# SET IT ON EVERY DEPLOYED CONTOUR (Vercel Production AND Preview/beta), to the stable admin
# host of that contour:
#   Production           -> https://admin.grbpwr.com
#   Preview (beta branch)-> https://admin.beta.grbpwr.com
# Unset, it falls back to window.location.origin — the address of the TAB that pressed
# "save as pdf". Printing from a Vercel preview alias then bakes an ephemeral, SSO-protected
# host into the paper; nothing fails visibly — the QR just dies later, in a workshop.
# The share link refuses that fallback when the tab itself is provably ephemeral (localhost,
# a bare IP, *.vercel.app): there the address and its copy button are not shown at all, because
# a copied localhost link handed to a contractor fails silently and the toast still says
# "copied". On a stable host the tab origin IS the product origin, so the button keeps working.
VITE_PATTERN_VIEWER_ORIGIN = ""

# Origin of the public file-share landing page ({origin}/f/{token}) — ALMOST NEVER NEEDED.
# It falls back to VITE_PATTERN_VIEWER_ORIGIN above, and every public page lives on the same
# host, so setting that one already covers this. Set this one only if /f/ ever moves to a
# domain of its own (a hypothetical files.grbpwr.com).
VITE_FILE_SHARE_ORIGIN = ""
